.godot/
*.tmp

# Summer Engine local-only state (SummerGit, caches, locks)
.summer/local/

# Reference art from Zoids Legacy: studied, never part of the game (CLAUDE.md "structure only"). Kept on disk, out of git.
docs/art/reference/legacy/
docs/art/2d/round4_legacy_study.png

# Godot user-data caches from test runs (paths too long for git on Windows; regenerated on every run)
**/local-profile/
**/shader_cache/

# Render rounds and working frames (2.2 GB; regenerated by the factory scripts). The top-level images in docs/art/2d
# (captures, lineups, sheets) stay in git.
docs/art/2d/*/

# Python bytecode (Claude, 2026-10-20)
__pycache__/
*.pyc

# Option A, 2026-11-14 (Preston: "A: game only"): source and workspace models stay on disk, out of git
*.blend
*.blend1
art/model_catalog/sources/
art/model_catalog/workspaces/
art/environment/foundry_5v5/workspaces/
docs/**/*.mp4
docs/**/*.zip
