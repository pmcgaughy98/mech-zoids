; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="new-mech-rpg (working title)"
run/main_scene="res://scenes/moba3d/arena_play.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="uid://cgmm0ex2vtja0"

[autoload]

Run="*res://scripts/run.gd"
KitAudio="*res://scripts/audio/kit_audio.gd"
MapAudio="*res://scripts/audio/map_audio.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="new-mech-rpg (working title)"

[gui]

theme/default_font_size=8

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

machine_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
machine_hidden={
"type": "float",
"value": 1.0
}

[summer]

version="0.7.0"
