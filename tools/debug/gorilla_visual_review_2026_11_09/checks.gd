extends "res://tools/debug/gorilla_visual_review_2026_11_09/review.gd"
var checks: Array=[]
func check(name: String, value: bool, detail: Variant=null) -> void:
	checks.append({"name":name,"pass":value,"detail":detail})
	print("CHECK ",name,": ",value)
func wait(seconds: float) -> void:await get_tree().create_timer(seconds).timeout
func prepare(index: int) -> void:
	set_shot(index)
	actor.move_override=Vector3.ZERO
	actor.input_override=Vector2.ZERO
	await wait(.12)
func _ready() -> void:
	super._ready()
	interactive=true
	run_checks.call_deferred()
func run_checks() -> void:
	await prepare(1)
	request("basic")
	await wait(.12)
	interrupt()
	await wait(.8)
	check("basic interrupted before contact: no damage",enemy.damage_calls==0)
	await prepare(2)
	request("shield")
	await wait(.13)
	interrupt()
	await wait(.7)
	check("shield interrupted before release: no shield",ApeKit.shield_on(actor)==null)
	await prepare(2)
	request("shield")
	await wait(.34)
	check("shield release creates actual shield",ApeKit.shield_on(actor)!=null)
	interrupt()
	await wait(.3)
	check("post-release interruption retains applied shield",ApeKit.shield_on(actor)!=null)
	await prepare(3)
	request("shield")
	await wait(.4)
	check("ally-directed release shields ally",ApeKit.shield_on(enemy)!=null and ApeKit.shield_on(actor)==null)
	await prepare(8)
	request("ult")
	await wait(.85)
	interrupt()
	await wait(.8)
	check("interrupted ultimate never creates cage",HexShield.live_domes().is_empty())
	await prepare(6)
	request("grab")
	await wait(.10)
	interrupt()
	await wait(.7)
	check("grab pre-capture interrupted: no damage or control lock",enemy.damage_calls==0 and not enemy.controls_disabled)
	await prepare(6)
	request("grab")
	await wait(.35)
	check("victim held during lift",enemy.controls_disabled and grab.captured)
	interrupt()
	await wait(.65)
	check("held victim released on interruption without damage",not enemy.controls_disabled and enemy.damage_calls==0)
	await prepare(6)
	request("grab")
	await wait(1.3)
	check("ground slam damages exactly once",enemy.damage_calls==1 and enemy.hp==72)
	check("ground slam finishes with control released",not enemy.controls_disabled and not grab.active)
	check("attachment stays exact",grab.max_attachment_error<.00001,grab.max_attachment_error)
	check("prone body stays above floor",enemy.visible_min_y()>-.0001,enemy.visible_min_y())
	await prepare(11)
	request("grab")
	await wait(1.2)
	check("grab miss: no damage",enemy.damage_calls==0)
	await prepare(4)
	request("drive")
	await wait(.1)
	interrupt()
	await wait(.8)
	check("Drive interrupted during brace: no damage",enemy.damage_calls==0 and drive.phase=="idle")
	await prepare(5)
	request("drive")
	await wait(1.3)
	check("Drive miss: no hit, completes braking",enemy.damage_calls==0 and drive.result=="miss",drive.result)
	await prepare(5)
	var wall:=StaticBody3D.new()
	wall.collision_layer=1
	var col:=CollisionShape3D.new()
	var shape:=BoxShape3D.new()
	shape.size=Vector3(6,3,.20)
	col.shape=shape
	wall.add_child(col)
	add_child(wall)
	wall.position=Vector3(0,1.5,2.5)
	await wait(.1)
	request("drive")
	await wait(1.3)
	check("Drive solid wall: stops and brakes",drive.result=="wall_stop",drive.result)
	check("Drive shield front remains before wall",actor.global_position.z+drive.FRONT<2.51,actor.global_position.z)
	check("Drive wall: no enemy impact",enemy.damage_calls==0)
	wall.queue_free()
	await prepare(1)
	fx.set_enabled(false)
	var count: int=fx.log_rows.size()
	request("basic")
	await wait(1.1)
	check("body-only preserves actual damage",enemy.damage_calls==1)
	check("body-only creates no contact FX",fx.log_rows.size()==count)
	var f:=FileAccess.open(OUT+"integration-checks.json",FileAccess.WRITE)
	f.store_string(JSON.stringify(checks,"  "))
	var failures:=checks.filter(func(c):return not c.pass)
	print("INTEGRATION_CHECKS: ",checks.size()," / FAILURES: ",failures.size())
	get_tree().quit(0 if failures.is_empty() else 1)
